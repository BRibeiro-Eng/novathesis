{
  // Ambas as receitas copiam o PDF final para a pasta da tese; a
  // pré-visualização deve abrir esse mesmo ficheiro. Os auxiliares de cada
  // receita continuam em diretórios temporários separados.
  "latex-workshop.latex.outDir": ".",

  // 2026-09-18: as duas receitas passam por scripts. A receita que chamava
  // "latexmk" directamente falhava sempre que o VS Code era aberto pelo Dock,
  // porque nesse caso o PATH nao tem /Library/TeX/texbin; e nao recriava
  // /tmp/tese-build depois de um arranque do macOS. Os scripts tratam das duas
  // coisas -- ver o cabecalho de _gerador/latexmk-vscode.sh.
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-wrapper",
      "command": "sh",
      "args": ["_gerador/latexmk-vscode.sh"],
      "env": {}
    },
    {
      "name": "build-sh",
      "command": "sh",
      "args": ["_gerador/build.sh"],
      "env": {}
    }
  ],

  "latex-workshop.latex.recipes": [
    { "name": "Tese (latexmk, incremental)", "tools": ["latexmk-wrapper"] },
    { "name": "Tese (build.sh, passagens fixas)", "tools": ["build-sh"] }
  ],

  // 285 paginas: compilar a cada gravacao seria insuportavel. Compilar a mao
  // com Cmd+Alt+B.
  "latex-workshop.latex.autoBuild.run": "never",
  "latex-workshop.latex.autoClean.run": "never"
}
